{
  "schema": "logdiagnosis.thread-annotations/v1",
  "created": "2026-09-25",
  "scope": "Previously unlabelled real logs (cohort adaptation_pool in data/cohorts/cohort_manifest.json) that could be downloaded and hash-checked by training/fetch_adaptation_pool.py.",
  "annotator_disclosure": "Every record was produced by a large language model (LLM) reading the cached forum thread. No human has reviewed these labels yet (reviewed_by_human=false). Each label cites a verbatim quote, its author and a post permalink so it can be checked independently; training/verify_thread_annotations.py re-checks every quote against the thread text.",
  "labelling_guide": {
    "source_rule": "A label needs a post by someone other than the original poster that names a cause, or an original-poster post confirming a found cause. Competing causes without resolution -> undiagnosed. Never use this project's rule engine or the forum search term.",
    "certainty": {
      "explicit": "cause stated plainly or confirmed by the log owner after investigation",
      "tentative": "cause stated with hedging ('seems', 'probably', 'looks like')"
    },
    "statuses": {
      "confirmed": "thread supports the previous label",
      "relabelled": "thread names a different cause",
      "undiagnosed": "no agreed cause in the thread",
      "not_a_failure": "the log is not a failure/crash flight (test flight, on-ground log, post-crash flight)",
      "not_real_flight": "simulation",
      "not_reviewed": "source not readable from the annotation environment",
      "labelled": "previously unlabelled log; thread names a cause",
      "out_of_taxonomy": "cause identified but not representable in the label set (e.g. IMU hardware failure)"
    },
    "label_definitions": "src/diagnosis/failure_types.py, applied strictly: sudden loss of thrust from one motor/ESC/prop (failure, desync, short, wiring) = mechanical_failure; one motor persistently weaker or a weight/yaw imbalance = motor_imbalance; all motors saturated because the vehicle is underpowered = thrust_loss; flight-controller supply loss or reboot = brownout; battery voltage sag or battery connection = power_instability; configuration or calibration error (motor order, ESC calibration, MOT_ params) = setup_error; poor PID tune or oscillation = pid_tuning_issue; estimator fault = ekf_failure."
  },
