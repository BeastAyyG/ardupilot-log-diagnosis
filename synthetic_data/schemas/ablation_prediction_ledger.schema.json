{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logdiagnosis.synthetic-ablation-predictions/v1",
  "type": "object",
  "required": [
    "schema",
    "non_promoting",
    "evaluation_role",
    "aggregation",
    "dataset",
    "declared_classes",
    "model_seeds",
    "arms",
    "accuracy_claim",
    "release_authorized"
  ],
  "properties": {
    "schema": {"const": "logdiagnosis.synthetic-ablation-predictions/v1"},
    "non_promoting": {"const": true},
    "evaluation_role": {"const": "development_dose_screen"},
    "aggregation": {
      "const": "maximum raw class probability by lineage_root_id"
    },
    "dataset": {
      "type": "object",
      "required": [
        "features_sha256",
        "labels_sha256",
        "groups_sha256",
        "split_ledger_sha256"
      ]
    },
    "declared_classes": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "model_seeds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"}
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "predictions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "predictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "lineage_root_id",
                "target_class",
                "target_class_id",
                "probabilities_by_class"
              ]
            }
          }
        }
      }
    },
    "accuracy_claim": {"const": "not_demonstrated"},
    "release_authorized": {"const": false}
  }
}
