{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logdiagnosis.temporal-fidelity/v1",
  "type": "object",
  "required": [
    "schema",
    "candidate_manifest_sha256",
    "feature_fidelity_design_sha256",
    "temporal_design_sha256",
    "temporal_ledger_sha256",
    "temporal_method_config_sha256",
    "dataset",
    "dataset_identity_verified",
    "real_lineages",
    "synthetic_lineages",
    "near_duplicate_audit_pass",
    "complete",
    "raw_temporal_checks_pass",
    "status",
    "required_strata",
    "evaluated_strata",
    "missing_strata",
    "metric_count",
    "release_authorized",
    "accuracy_claim"
  ],
  "properties": {
    "schema": {"const": "logdiagnosis.temporal-fidelity/v1"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_fidelity_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temporal_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temporal_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temporal_method_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset": {"type": "object"},
    "dataset_identity_verified": {"const": true},
    "real_lineages": {"type": "integer", "minimum": 0},
    "synthetic_lineages": {"type": "integer", "minimum": 0},
    "near_duplicate_audit_pass": {"const": true},
    "complete": {"type": "boolean"},
    "raw_temporal_checks_pass": {"type": "boolean"},
    "status": {"type": "string", "minLength": 1},
    "required_strata": {"type": "integer", "minimum": 1},
    "evaluated_strata": {"type": "integer", "minimum": 0},
    "missing_strata": {"type": "integer", "minimum": 0},
    "metric_count": {"type": "integer", "minimum": 0},
    "release_authorized": {"const": false},
    "accuracy_claim": {"const": "not_demonstrated"}
  }
}
