{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logdiagnosis.temporal-fidelity-design/v1",
  "type": "object",
  "required": [
    "schema",
    "candidate_manifest_sha256",
    "feature_fidelity_design_sha256",
    "required_strata",
    "required_channels",
    "channel_sources",
    "channel_pairs",
    "acf_lags_sec",
    "psd_bands_hz",
    "minimum_lineages_per_domain_per_stratum",
    "bootstrap_draws",
    "seed",
    "frozen_before_evaluation",
    "require_transition_timing",
    "maximum_cross_channel_lag_sec"
  ],
  "properties": {
    "schema": {"const": "logdiagnosis.temporal-fidelity-design/v1"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_fidelity_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["primary_label", "flight_phase", "vehicle_frame", "firmware_commit", "simulation_family"]
      }
    },
    "required_channels": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "channel_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["message_type", "value_field", "time_field", "time_scale_to_sec", "value_scale", "value_offset", "selector"],
        "properties": {
          "message_type": {"type": "string", "minLength": 1},
          "value_field": {"type": "string", "minLength": 1},
          "time_field": {"type": "string", "minLength": 1},
          "time_scale_to_sec": {"type": "number", "minimum": 0.000000000001},
          "value_scale": {"type": "number"},
          "value_offset": {"type": "number"},
          "selector": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "channel_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["one", "two"],
        "properties": {
          "one": {"type": "string", "minLength": 1},
          "two": {"type": "string", "minLength": 1}
        }
      }
    },
    "acf_lags_sec": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0.000001}
    },
    "psd_bands_hz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "low_hz", "high_hz"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "low_hz": {"type": "number", "minimum": 0},
          "high_hz": {"type": "number", "minimum": 0.000001}
        }
      }
    },
    "minimum_lineages_per_domain_per_stratum": {"type": "integer", "minimum": 8},
    "bootstrap_draws": {"type": "integer", "minimum": 1000},
    "seed": {"type": "integer", "minimum": 0},
    "frozen_before_evaluation": {"const": true},
    "require_transition_timing": {"type": "boolean"},
    "maximum_cross_channel_lag_sec": {"type": "number", "minimum": 0.000001}
  },
  "additionalProperties": false
}
